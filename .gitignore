# =============================================================================
# Room_Agent - Root .gitignore (Strict Security & Runtime Isolation)
# =============================================================================

# 1. Environment, Secrets & Credentials (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.token
*.secret
*.credentials.json
*credentials*.json
.credentials.json
.mcp.json
tools/update_outline_*.py

# 2. Python Runtimes & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 3. Local SQLite, Harness Runtime State & Databases (NEVER COMMIT)
/.harness/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
.harness_local_db.json
.harness_progress.json
.harness_hooks.jsonl

# 4. Node.js, Frontend & Build Artifacts
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.angular/
.astro/
.nx/cache/
coverage/
.turbo/
target/
**/target/

# 5. OS, IDE & Agent Runtime Symlinks
.agents/
.claude/
*/.claude/
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~

# 6. Temporary & Backup Files
*.bak
*.bak.*
*.tmp
*.temp
*.log
scratch/

# 7. Sub-projects & External Workspaces (NEVER COMMIT)
/projects/
/private/
/game/
/codex-room-setup/
.worktrees/
.rooms

# 8. Auto-generated Research & Test Briefs (NEVER COMMIT)
tools/research/gen_brief_*.md
tools/research/research_*.md
tools/research/reports/
!tools/research/README.md
!tools/research/*.py

# 9. Ephemeral Room Coordination, Meeting Memos, Architecture Graph & Working Artifacts
bmad/architecture.json
bmad/adrs/
bmad/rooms/supervisor/
bmad/rooms/pm/
bmad/rooms/lead/
bmad/rooms/peer/
bmad/rooms/qc/
bmad/rooms/tasks/
bmad/rooms/violations/
bmad/rooms/archive/
bmad/rooms/discussions/
bmad/rooms/approvals/
bmad/rooms/*.json
!bmad/rooms/README.md
!bmad/rooms/template-handoff.md
docs/AGENT_PROGRESS.md

