# =============================================================================
# Paseo Project Workspace - Root .gitignore
# =============================================================================

# 1. Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.token
*.credentials.json
.credentials.json

# 2. Python Runtimes & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 3. Local SQLite & Databases
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
.harness_local_db.json

# 4. Node.js, Frontend & Build Artifacts
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.angular/
.nx/cache/
coverage/
.turbo/

# 5. OS & IDE Configuration
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~

# 6. Temporary & Backup Files
*.bak
*.bak.*
*.tmp
*.temp
scratch/

# 7. Sub-projects (own repos)
/projects/

# 8. Company-identifying
/private/
/.agents/
/tools/crm_doc_reader.py
/tools/distill_ba_beats.py
/spec_slider.md
/game/
/codex-room-setup/
/.harness_progress.json