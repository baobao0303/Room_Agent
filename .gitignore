# 1. Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.token
*.credentials.json
.credentials.json
.mcp.json
tools/update_outline_*.py

# 2. Python Runtimes & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 3. Local SQLite & Databases
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
.harness_local_db.json

# 4. Node.js, Frontend & Build Artifacts
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.angular/
.astro/
.nx/cache/
coverage/
.turbo/
target/
**/target/

# 5. OS & IDE Configuration
.claude/
*/.claude/
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~

# 6. Temporary & Backup Files
*.bak
*.bak.*
*.tmp
*.temp
scratch/

# 7. Sub-projects (own repos)
/projects/

# 8. Company-identifying
/private/
/.agents/
/tools/crm_doc_reader.py
/tools/distill_ba_beats.py
/spec_slider.md
/game/
/codex-room-setup/
/.harness_progress.json
/.harness_hooks.jsonl

# 9. Auto-generated research & test briefs
tools/research/
!tools/research/
!tools/research/README.md
!tools/research/*.py
!tools/research/reports/**

# 10. Ephemeral Room Coordination, Meeting Memos & Working Artifacts
bmad/rooms/lead/
bmad/rooms/peer/
bmad/rooms/qc/
bmad/rooms/supervisor/
bmad/rooms/pm/
bmad/rooms/tasks/
bmad/rooms/violations/
bmad/rooms/archive/
bmad/rooms/*.json
!bmad/rooms/README.md
