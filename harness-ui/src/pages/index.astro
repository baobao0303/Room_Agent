---
// index.astro - Paseo Control Center Single Page Cockpit
import DashboardLayout from '../layouts/DashboardLayout.astro';
import KpiStrip from '../components/KpiStrip.astro';
import WorkItemsBoard from '../components/WorkItemsBoard.astro';
import SlpcAgentsPanel from '../components/SlpcAgentsPanel.astro';
import QcWorkbench from '../components/QcWorkbench.astro';
import ProgressLedger from '../components/ProgressLedger.astro';
---

<DashboardLayout title="Paseo Control Center - SLPC Cockpit">
  <!-- Top KPI Metric Strip -->
  <KpiStrip />

  <!-- Tab 1: Work Items Board -->
  <section id="tab-work-items" data-tab-content="work-items" class="tab-panel active">
    <div class="panel-card">
      <div class="panel-header">
        <div class="panel-title-area">
          <span class="panel-tag">WORK ITEMS</span>
          <h3>Bảng điều phối công việc (Backlog &amp; Sprints)</h3>
        </div>
      </div>
      <WorkItemsBoard />
    </div>
  </section>

  <!-- Tab 2: SLPC Agents Control Panel -->
  <section id="tab-slpc-agents" data-tab-content="slpc-agents" class="tab-panel" hidden style="display: none;">
    <div class="panel-card">
      <div class="panel-header">
        <div class="panel-title-area">
          <span class="panel-tag">SLPC MULTI-AGENT</span>
          <h3>Quản lý 4 Vai Trò Điều Phối (Supervisor, Lead, Peer, QC)</h3>
        </div>
      </div>
      <SlpcAgentsPanel />
    </div>
  </section>

  <!-- Tab 3: QC Automation Workbench -->
  <section id="tab-qc-workbench" data-tab-content="qc-workbench qc-automation" class="tab-panel" hidden style="display: none;">
    <div class="panel-card">
      <div class="panel-header">
        <div class="panel-title-area">
          <span class="panel-tag">QC AUTOMATION</span>
          <h3>5-Stage ISTQB Test Generator &amp; Background Job Runner</h3>
        </div>
      </div>
      <QcWorkbench />
    </div>
  </section>

  <!-- Tab 4: Progress & Ledger -->
  <section id="tab-progress-ledger" data-tab-content="progress-ledger" class="tab-panel" hidden style="display: none;">
    <div class="panel-card">
      <div class="panel-header">
        <div class="panel-title-area">
          <span class="panel-tag">LEDGER &amp; CONTEXT</span>
          <h3>Tiến độ &amp; Nhật ký Phiên Làm Việc (Context Window Explorer)</h3>
        </div>
      </div>
      <ProgressLedger view="ledger" />
    </div>
  </section>

  <!-- Tab 5: Spec Portal -->
  <section id="tab-spec-portal" data-tab-content="spec-portal" class="tab-panel" hidden style="display: none;">
    <div class="panel-card">
      <div class="panel-header">
        <div class="panel-title-area">
          <span class="panel-tag">SPECIFICATIONS</span>
          <h3>Cổng Tài Liệu Đặc Tả Dự Án (Spec Portal)</h3>
        </div>
      </div>
      <ProgressLedger view="specs" />
    </div>
  </section>
</DashboardLayout>

<style>
  .tab-panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .panel-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .panel-title-area {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .panel-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--primary);
  }

  .panel-header h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
  }

  @media (max-width: 900px) {
    .panel-card {
      padding: 16px;
    }
  }
</style>
