---
import '../styles/global.css';

interface Props {
  title?: string;
  activeTab?: string;
}

const { title = "Paseo Control Center", activeTab = "work-items" } = Astro.props;

const harnessEnv = {
  PUBLIC_DEPLOY_URL: import.meta.env.PUBLIC_DEPLOY_URL || "http://100.124.36.46:4321",
  PUBLIC_API_BASE_URL: import.meta.env.PUBLIC_API_BASE_URL || "http://100.92.98.99:8765",
  PUBLIC_TAILSCALE_API_URL: import.meta.env.PUBLIC_TAILSCALE_API_URL || "http://100.92.98.99:8765",
  PUBLIC_PASEO_DAEMON_URL: import.meta.env.PUBLIC_PASEO_DAEMON_URL || "http://127.0.0.1:6767",
  PUBLIC_HARNESS_BACKEND: import.meta.env.PUBLIC_HARNESS_BACKEND || "floci",
  PUBLIC_FLOCI_ENDPOINT: import.meta.env.PUBLIC_FLOCI_ENDPOINT || "http://100.124.36.46:14566",
  PUBLIC_FLOCI_S3_BUCKET: import.meta.env.PUBLIC_FLOCI_S3_BUCKET || "harness-data",
  PUBLIC_HARNESS_MODEL: import.meta.env.PUBLIC_HARNESS_MODEL || "gemini-3.7-medium",
  PUBLIC_AWS_REGION: import.meta.env.PUBLIC_AWS_REGION || "us-east-1",
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Paseo Control Center - SLPC Autonomous Harness UI (Hand-Drawn Sketch-Note)" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline define:vars={{ harnessEnv }}>
      (function () {
        window["__HARNESS_ENV__"] = harnessEnv;
        const rawFetch = window.fetch.bind(window);
        const configuredBase = (harnessEnv.PUBLIC_API_BASE_URL || "http://100.92.98.99:8765").replace(/\/+$/, "");
        const tailscaleBase = (harnessEnv.PUBLIC_TAILSCALE_API_URL || "http://100.92.98.99:8765").replace(/\/+$/, "");

        function normalizeNodeUrl(raw) {
          let u = String(raw || "").trim();
          if (!u) return "";
          if (u.startsWith("paseo://")) u = "http://" + u.slice("paseo://".length);
          if (!u.startsWith("http://") && !u.startsWith("https://")) u = "http://" + u;
          return u.replace(/\/+$/, "");
        }

        let activeNodeUrl = "";
        let lastGoodBase = "";
        try {
          const saved = normalizeNodeUrl(localStorage.getItem("paseo_active_node") || "");
          // Ignore static frontend port :4321 as an API node
          if (saved && !saved.endsWith(":4321")) {
            activeNodeUrl = saved;
          }
        } catch (e) {}
        window["__PASEO_ACTIVE_NODE__"] = activeNodeUrl || configuredBase;

        window["__PASEO_SET_NODE__"] = function (newUrl) {
          const norm = normalizeNodeUrl(newUrl);
          activeNodeUrl = (norm && !norm.endsWith(":4321")) ? norm : "";
          lastGoodBase = activeNodeUrl || "";
          window["__PASEO_ACTIVE_NODE__"] = activeNodeUrl || configuredBase;
          try {
            if (activeNodeUrl) localStorage.setItem("paseo_active_node", activeNodeUrl);
            else localStorage.removeItem("paseo_active_node");
          } catch (e) {}
          window.dispatchEvent(new CustomEvent("paseo-node-changed", { detail: { url: window["__PASEO_ACTIVE_NODE__"] } }));
        };

        function getCandidateBases() {
          const bases = [];
          const loc = window.location;
          const isSameBackendPort = loc.port === "8765";
          if (activeNodeUrl) {
            bases.push(activeNodeUrl);
          }
          if (lastGoodBase) {
            bases.push(lastGoodBase);
          }
          if (isSameBackendPort && (loc.protocol === "http:" || loc.protocol === "https:")) {
            bases.push("");
          }
          if (configuredBase) {
            bases.push(configuredBase);
          }
          if (tailscaleBase) {
            bases.push(tailscaleBase);
          }
          if (loc.hostname && loc.hostname !== "127.0.0.1") {
            bases.push(`http://${loc.hostname}:8765`);
          }
          bases.push("http://127.0.0.1:8765");
          if (!isSameBackendPort && (loc.protocol === "http:" || loc.protocol === "https:")) {
            bases.push("");
          }
          return Array.from(new Set(bases));
        }

        window.fetch = async function (input, init) {
          const urlStr = typeof input === "string" ? input : (input instanceof URL ? input.toString() : null);
          if (urlStr && urlStr.startsWith("/api/")) {
            const bases = getCandidateBases();
            const method = (init && init.method ? String(init.method) : "GET").toUpperCase();
            let lastErr = null;
            let lastRes = null;
            for (const base of bases) {
              const candidate = base + urlStr;
              const controller = typeof AbortController !== "undefined" ? new AbortController() : null;
              const timeoutMs = method === "GET" ? 4000 : 15000;
              const timer = controller ? setTimeout(() => controller.abort(), timeoutMs) : null;
              try {
                const reqInit = Object.assign({ cache: "no-store" }, init || {});
                if (controller && !reqInit.signal) {
                  reqInit.signal = controller.signal;
                }
                const res = await rawFetch(candidate, reqInit);
                if (timer) clearTimeout(timer);
                if (res.ok || (res.status >= 400 && res.status < 500 && res.status !== 404)) {
                  lastGoodBase = base;
                  return res;
                }
                lastRes = res;
              } catch (err) {
                if (timer) clearTimeout(timer);
                lastErr = err;
              }
            }
            if (lastRes) return lastRes;
            throw lastErr || new Error("Cannot reach Harness Backend API (:8765)");
          }
          return rawFetch(input, init);
        };
      })();
    </script>
  </head>
  <body>
    <div class="dashboard-shell">
      <!-- Header Topbar -->
      <header class="topbar">
        <div class="topbar-brand">
          <div class="brand-logo">
            <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <rect width="30" height="30" x="1" y="1" rx="6" fill="#161b22" stroke="#30363d" stroke-width="1.5"/>
              <path d="M7 16H11L14 10L18 22L21 16H25" stroke="#39d353" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="25" cy="16" r="2.5" fill="#39d353"/>
            </svg>
          </div>
          <div class="brand-text">
            <span class="brand-title"><span class="green-accent">&gt;</span> PASEO CONTROL CENTER<span class="cursor-blink">_</span></span>
            <span class="brand-sub">SLPC TERMINAL HARNESS // CLI v2.6</span>
          </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="nav-tabs" aria-label="Main Navigation">
          <button
            type="button"
            class={`nav-tab ${activeTab === 'work-items' ? 'active' : ''}`}
            data-tab-target="work-items"
            id="nav-tab-work-items"
            role="tab"
            aria-selected={activeTab === 'work-items' ? 'true' : 'false'}
            aria-controls="tab-work-items"
          >
            <span>Work Items Board</span>
            <span class="tab-pill" id="nav-count">--</span>
          </button>

          <button
            type="button"
            class={`nav-tab ${activeTab === 'slpc-agents' ? 'active' : ''}`}
            data-tab-target="slpc-agents"
            id="nav-tab-slpc-agents"
            role="tab"
            aria-selected={activeTab === 'slpc-agents' ? 'true' : 'false'}
            aria-controls="tab-slpc-agents"
          >
            <span>SLPC Agents</span>
          </button>

          <button
            type="button"
            class={`nav-tab ${activeTab === 'qc-workbench' || activeTab === 'qc-automation' ? 'active' : ''}`}
            data-tab-target="qc-workbench"
            id="nav-tab-qc-workbench"
            role="tab"
            aria-selected={activeTab === 'qc-workbench' || activeTab === 'qc-automation' ? 'true' : 'false'}
            aria-controls="tab-qc-workbench"
          >
            <span>QC Workbench</span>
          </button>

          <button
            type="button"
            class={`nav-tab ${activeTab === 'progress-ledger' ? 'active' : ''}`}
            data-tab-target="progress-ledger"
            id="nav-tab-progress-ledger"
            role="tab"
            aria-selected={activeTab === 'progress-ledger' ? 'true' : 'false'}
            aria-controls="tab-progress-ledger"
          >
            <span>Progress &amp; Ledger</span>
          </button>

          <button
            type="button"
            class={`nav-tab ${activeTab === 'spec-portal' ? 'active' : ''}`}
            data-tab-target="spec-portal"
            id="nav-tab-spec-portal"
            role="tab"
            aria-selected={activeTab === 'spec-portal' ? 'true' : 'false'}
            aria-controls="tab-spec-portal"
          >
            <span>Spec Portal</span>
          </button>
        </nav>

        <!-- Right System Controls -->
        <div class="topbar-actions">
          <div id="env-status-pill" class="badge-tag" title={`ENV: BACKEND=${harnessEnv.PUBLIC_HARNESS_BACKEND} | FLOCI=${harnessEnv.PUBLIC_FLOCI_ENDPOINT} | MODEL=${harnessEnv.PUBLIC_HARNESS_MODEL}`}>
            ENV: <strong id="env-backend-label">{harnessEnv.PUBLIC_HARNESS_BACKEND}</strong> • <span id="env-model-label">{harnessEnv.PUBLIC_HARNESS_MODEL}</span>
          </div>

          <button
            type="button"
            id="btn-doctor-pill"
            class="badge live doctor-pill-btn"
            title="Continuous Doctor & Auto-Healer (Click để mở bảng kiểm tra lỗi liên tục 8 phân hệ)"
          >
            <span class="pulse-dot" id="doctor-dot"></span>
            <span id="doctor-pill-text">🩺 Doctor: 8/8 OK</span>
          </button>

          <div id="backend-status" class="badge live" title={`Backend Server connection status (${harnessEnv.PUBLIC_API_BASE_URL})`}>
            <span class="pulse-dot"></span>
            <span id="st-text">Connecting (:8765)...</span>
          </div>

          <button type="button" id="btn-global-refresh" class="icon-btn" title="Refresh state from backend" aria-label="Refresh">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
            </svg>
          </button>
        </div>
      </header>

      <!-- Main Workspace Container -->
      <main class="dashboard-main" id="dashboard-content">
        <slot />
      </main>

      <!-- Footer Status Line -->
      <footer class="dashboard-footer">
        <div class="footer-left">
          <span>PASEO SLPC HARNESS</span>
          <span class="dot-separator">•</span>
          <span>DEPLOY: <code class="mono-code" id="footer-deploy-url">{harnessEnv.PUBLIC_DEPLOY_URL}</code></span>
          <span class="dot-separator">•</span>
          <span>API: <code class="mono-code" id="footer-api-url">{harnessEnv.PUBLIC_API_BASE_URL}</code></span>
          <span class="dot-separator">•</span>
          <span>FLOCI: <code class="mono-code" id="footer-floci-url">{harnessEnv.PUBLIC_FLOCI_ENDPOINT}</code></span>
          <span class="dot-separator">•</span>
          <span>BUCKET: <code class="mono-code" id="footer-s3-bucket">{harnessEnv.PUBLIC_FLOCI_S3_BUCKET}</code></span>
        </div>
        <div class="footer-right">
          <span id="footer-last-sync">Chưa đồng bộ</span>
          <span class="dot-separator">•</span>
          <span class="badge-tag">Terminal Green • Astro 5 (.env Connected)</span>
        </div>
      </footer>

      <!-- Modal: Continuous Harness Doctor & Auto-Healer -->
      <dialog id="dlg-doctor-monitor" class="dashboard-dialog doctor-dialog" aria-labelledby="dlg-doctor-title">
        <div class="doctor-dlg-header">
          <div class="doctor-dlg-title-wrap">
            <span class="doctor-tag">CONTINUOUS WATCHDOG // AUTO-HEAL ENGINE</span>
            <h3 id="dlg-doctor-title">🩺 Bộ Kiểm Tra Lỗi Liên Tục &amp; Tự Sửa Lỗi (Harness Doctor)</h3>
          </div>
          <div class="doctor-header-meta">
            <span id="doctor-overall-badge" class="badge live">HEALTHY (100%)</span>
            <button type="button" id="btn-close-doctor" class="icon-btn" aria-label="Đóng">✕</button>
          </div>
        </div>

        <div class="doctor-dlg-toolbar">
          <div class="doctor-meta-stats">
            <span>Lần quét gần nhất: <strong id="doctor-checked-at">--</strong></span>
            <span class="dot-separator">•</span>
            <span>Chu kỳ: <strong>8s / lần (Liên tục)</strong></span>
            <span class="dot-separator">•</span>
            <span>CLI: <code class="mono-code">./scripts/harness doctor --watch</code></span>
          </div>
          <div class="doctor-toolbar-actions">
            <label class="doctor-toggle-lbl">
              <input type="checkbox" id="chk-doctor-autoheal" checked />
              <span>Tự động sửa lỗi (Auto-Heal)</span>
            </label>
            <button type="button" id="btn-doctor-heal-now" class="btn-doctor-action">
              ⚡ Quét &amp; Tự Sửa Lỗi Ngay
            </button>
          </div>
        </div>

        <div class="doctor-dlg-body">
          <div class="doctor-checks-grid" id="doctor-checks-grid">
            <div class="doctor-check-card">Đang tải trạng thái 8 phân hệ...</div>
          </div>

          <div class="doctor-log-section">
            <div class="doctor-log-hdr">
              <span>NHẬT KÝ PHÁT HIỆN &amp; TỰ ĐỘNG SỬA LỖI (AUTO-HEAL LOG)</span>
              <span id="doctor-heal-count">0 sự kiện</span>
            </div>
            <div class="doctor-heal-list" id="doctor-heal-list">
              <div class="doctor-empty-log">Hệ thống đang hoạt động ổn định. Chưa có lỗi phát sinh cần can thiệp.</div>
            </div>
          </div>
        </div>
      </dialog>
    </div>

    <!-- Client-side tab management & backend connection polling -->
    <script>
      let uiVer: string | null = null;
      let pollInterval: number | null = null;

      function normalizeTab(t: string): string {
        if (t === 'qc-automation') return 'qc-workbench';
        return t;
      }

      function updateActiveTab(tabName: string) {
        const norm = normalizeTab(tabName);
        const tabs = document.querySelectorAll<HTMLButtonElement>('.nav-tab');
        const panels = document.querySelectorAll<HTMLElement>('[data-tab-content]');

        let found = false;
        tabs.forEach((tab) => {
          const target = normalizeTab(tab.dataset.tabTarget || '');
          const isActive = target === norm;
          if (isActive) {
            tab.classList.add('active');
            tab.setAttribute('aria-selected', 'true');
            found = true;
          } else {
            tab.classList.remove('active');
            tab.setAttribute('aria-selected', 'false');
          }
        });

        // Default to work-items if target not found
        const effectiveTab = found ? norm : 'work-items';

        panels.forEach((panel) => {
          const contents = (panel.dataset.tabContent || '').split(' ').map(normalizeTab);
          const panelId = panel.id.replace(/^tab-/, '');
          const isMatch = contents.includes(effectiveTab) || normalizeTab(panelId) === effectiveTab;
          if (isMatch) {
            panel.removeAttribute('hidden');
            panel.style.display = 'block';
          } else {
            panel.setAttribute('hidden', '');
            panel.style.display = 'none';
          }
        });

        if (window.location.hash !== `#${effectiveTab}`) {
          history.replaceState(null, '', `#${effectiveTab}`);
        }
      }

      function initTabs() {
        const tabs = document.querySelectorAll<HTMLButtonElement>('.nav-tab');
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const target = tab.dataset.tabTarget;
            if (target) {
              updateActiveTab(target);
            }
          });
        });

        // Listen for custom tab switch requests from child components
        window.addEventListener('switch-tab', ((e: CustomEvent<{ tab: string }>) => {
          if (e.detail?.tab) {
            updateActiveTab(e.detail.tab);
          }
        }) as EventListener);

        // Handle URL hash changes
        window.addEventListener('hashchange', () => {
          const hash = window.location.hash.replace(/^#/, '');
          if (hash) {
            updateActiveTab(hash);
          }
        });

        // Initial tab from hash or default
        const initialHash = window.location.hash.replace(/^#/, '');
        if (initialHash) {
          updateActiveTab(initialHash);
        } else {
          updateActiveTab('work-items');
        }
      }

      let isPollingHeartbeat = false;

      async function pollHeartbeat(force = false) {
        if (isPollingHeartbeat && !force) return;
        isPollingHeartbeat = true;
        const statusEl = document.getElementById('backend-status');
        const statusText = document.getElementById('st-text');
        const navCount = document.getElementById('nav-count');
        const footerSync = document.getElementById('footer-last-sync');

        try {
          const url = '/api/work-items?' + (force ? 'force=1&' : '') + 't=' + Date.now();
          const res = await fetch(url, { cache: 'no-store' });

          if (!res.ok) {
            throw new Error(`HTTP ${res.status}`);
          }

          // Check for server-side template/version changes
          const ver = res.headers.get('X-UI-Version');
          if (ver) {
            if (uiVer && uiVer !== ver) {
              console.log('[Paseo Control Center] UI version updated on backend, reloading page...');
              window.location.reload();
              return;
            }
            uiVer = ver;
          }

          const data = await res.json();
          const items = Array.isArray(data) ? data : (data.items || []);

          if (statusEl && statusText) {
            statusEl.className = 'badge live';
            statusText.textContent = 'Live (:8765)';
          }

          if (navCount) {
            navCount.textContent = String(items.length);
          }

          if (footerSync) {
            const timeStr = new Date().toLocaleTimeString('vi-VN');
            footerSync.textContent = `Đồng bộ lúc ${timeStr}`;
          }

          // Broadcast work items to components (e.g. KpiStrip, WorkItemsBoard, SlpcAgentsPanel)
          window.dispatchEvent(new CustomEvent('work-items-updated', { detail: items }));
        } catch (err) {
          if (statusEl && statusText) {
            statusEl.className = 'badge err';
            statusText.textContent = 'Offline (:8765)';
          }
          if (footerSync) {
            footerSync.textContent = 'Mất kết nối backend (:8765)';
          }
          window.dispatchEvent(new CustomEvent('backend-offline'));
        } finally {
          isPollingHeartbeat = false;
        }
      }

      async function syncBackendEnv() {
        try {
          const res = await fetch('/api/env?t=' + Date.now(), { cache: 'no-store' });
          if (!res.ok) return;
          const envData = await res.json();
          const elBackend = document.getElementById('env-backend-label');
          const elModel = document.getElementById('env-model-label');
          const elApi = document.getElementById('footer-api-url');
          const elFloci = document.getElementById('footer-floci-url');
          const elBucket = document.getElementById('footer-s3-bucket');
          if (elBackend && envData.HARNESS_BACKEND) elBackend.textContent = envData.HARNESS_BACKEND;
          if (elModel && envData.HARNESS_MODEL) elModel.textContent = envData.HARNESS_MODEL;
          if (elApi && envData.PUBLIC_API_BASE_URL) elApi.textContent = envData.PUBLIC_API_BASE_URL;
          if (elFloci && envData.FLOCI_ENDPOINT) elFloci.textContent = envData.FLOCI_ENDPOINT;
          if (elBucket && envData.FLOCI_S3_BUCKET) elBucket.textContent = envData.FLOCI_S3_BUCKET;
        } catch {
          // Ignore if /api/env not available yet
        }
      }

      interface DoctorCheckItem {
        id: string;
        name: string;
        status: 'ok' | 'warn' | 'error';
        latency_ms: number;
        summary: string;
        healed?: {
          timestamp: string;
          subsystem: string;
          action: string;
          success: boolean;
          detail?: string;
        } | null;
      }

      interface DoctorReport {
        ok: boolean;
        overall: 'HEALTHY' | 'DEGRADED' | 'CRITICAL';
        score: number;
        ok_count: number;
        warn_count: number;
        error_count: number;
        total_checks: number;
        auto_heal_enabled: boolean;
        checked_at: string;
        checks: DoctorCheckItem[];
        heal_history?: Array<{
          timestamp: string;
          subsystem: string;
          action: string;
          success: boolean;
          detail?: string;
        }>;
      }

      let doctorInterval: number | null = null;

      function escDoc(s: unknown): string {
        return String(s ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function renderDoctorReport(rep: DoctorReport) {
        const pillBtn = document.getElementById('btn-doctor-pill');
        const pillText = document.getElementById('doctor-pill-text');
        const overallBadge = document.getElementById('doctor-overall-badge');
        const checkedAtEl = document.getElementById('doctor-checked-at');
        const autoHealChk = document.getElementById('chk-doctor-autoheal') as HTMLInputElement | null;
        const gridEl = document.getElementById('doctor-checks-grid');
        const healListEl = document.getElementById('doctor-heal-list');
        const healCountEl = document.getElementById('doctor-heal-count');

        const isHealthy = rep.overall === 'HEALTHY';
        const isCrit = rep.overall === 'CRITICAL';
        const badgeCls = isCrit ? 'badge err' : (isHealthy ? 'badge live' : 'badge warn');

        if (pillBtn && pillText) {
          pillBtn.className = `${badgeCls} doctor-pill-btn`;
          pillText.textContent = `🩺 Doctor: ${rep.ok_count}/${rep.total_checks} OK (${rep.score}%)`;
        }

        if (overallBadge) {
          overallBadge.className = badgeCls;
          overallBadge.textContent = `${rep.overall} (${rep.score}%)`;
        }

        if (checkedAtEl) {
          checkedAtEl.textContent = rep.checked_at || '--';
        }

        if (autoHealChk && document.activeElement !== autoHealChk) {
          autoHealChk.checked = Boolean(rep.auto_heal_enabled);
        }

        if (gridEl && Array.isArray(rep.checks)) {
          gridEl.innerHTML = rep.checks
            .map((c) => {
              const icon = c.status === 'ok' ? '✓' : c.status === 'warn' ? '⚠' : '✗';
              const stClass = `st-${c.status}`;
              const healBanner = c.healed
                ? `<div class="doc-heal-tag">⚡ Tự sửa: ${escDoc(c.healed.action)}</div>`
                : '';
              return `
                <div class="doctor-check-card ${stClass}">
                  <div class="doc-card-top">
                    <span class="doc-status-icon ${stClass}">${icon}</span>
                    <strong class="doc-card-name">${escDoc(c.name)}</strong>
                  </div>
                  <div class="doc-card-summary">${escDoc(c.summary)}</div>
                  ${healBanner}
                </div>`;
            })
            .join('');
        }

        const history = rep.heal_history || [];
        if (healCountEl) {
          healCountEl.textContent = `${history.length} sự kiện`;
        }
        if (healListEl) {
          if (history.length === 0) {
            healListEl.innerHTML =
              '<div class="doctor-empty-log">✓ Hệ thống đang hoạt động ổn định. Chưa có lỗi phát sinh cần can thiệp.</div>';
          } else {
            healListEl.innerHTML = history
              .map(
                (h) => `
                <div class="doc-heal-row ${h.success ? 'ok' : 'err'}">
                  <span class="doc-heal-time">[${escDoc(h.timestamp)}]</span>
                  <span class="doc-heal-sub">${escDoc(h.subsystem)}</span>
                  <span class="doc-heal-act">${escDoc(h.action)}</span>
                  <span class="doc-heal-res">${h.success ? '✓ FIXED' : '✗ FAILED'}</span>
                </div>`
              )
              .join('');
          }
        }
      }

      async function pollDoctor(force = false) {
        try {
          const url = '/api/doctor?' + (force ? 'force=1&' : '') + 't=' + Date.now();
          const res = await fetch(url, { cache: 'no-store' });
          if (!res.ok) return;
          const rep: DoctorReport = await res.json();
          renderDoctorReport(rep);
        } catch {
          // Handled by heartbeat offline indicator
        }
      }

      async function triggerDoctorHeal() {
        const btn = document.getElementById('btn-doctor-heal-now') as HTMLButtonElement | null;
        const autoHealChk = document.getElementById('chk-doctor-autoheal') as HTMLInputElement | null;
        if (btn) {
          btn.disabled = true;
          btn.textContent = '⏳ Đang quét & tự sửa lỗi...';
        }
        try {
          const res = await fetch('/api/doctor/heal', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ auto_heal: Boolean(autoHealChk?.checked ?? true) }),
          });
          if (res.ok) {
            const rep: DoctorReport = await res.json();
            renderDoctorReport(rep);
            pollHeartbeat(true);
          }
        } finally {
          if (btn) {
            btn.disabled = false;
            btn.textContent = '⚡ Quét & Tự Sửa Lỗi Ngay';
          }
        }
      }

      function initConnection() {
        const refreshBtn = document.getElementById('btn-global-refresh');
        if (refreshBtn) {
          refreshBtn.addEventListener('click', () => {
            syncBackendEnv();
            pollHeartbeat(true);
            pollDoctor(true);
            window.dispatchEvent(new CustomEvent('force-refresh-all'));
          });
        }

        const doctorPill = document.getElementById('btn-doctor-pill');
        const doctorDlg = document.getElementById('dlg-doctor-monitor') as HTMLDialogElement | null;
        doctorPill?.addEventListener('click', () => {
          doctorDlg?.showModal();
          pollDoctor(true);
        });
        document.getElementById('btn-close-doctor')?.addEventListener('click', () => {
          doctorDlg?.close();
        });
        document.getElementById('btn-doctor-heal-now')?.addEventListener('click', () => {
          triggerDoctorHeal();
        });
        document.getElementById('chk-doctor-autoheal')?.addEventListener('change', () => {
          triggerDoctorHeal();
        });

        window.addEventListener('focus', () => {
          pollHeartbeat(false);
          pollDoctor(false);
        });
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') {
            pollHeartbeat(false);
            pollDoctor(false);
          }
        });

        syncBackendEnv();
        pollHeartbeat(false);
        pollDoctor(false);
        pollInterval = window.setInterval(() => pollHeartbeat(false), 2500);
        doctorInterval = window.setInterval(() => pollDoctor(false), 5000);
      }

      // Initialize on DOM ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initTabs();
          initConnection();
        });
      } else {
        initTabs();
        initConnection();
      }

      window.addEventListener('beforeunload', () => {
        if (pollInterval !== null) {
          clearInterval(pollInterval);
        }
        if (doctorInterval !== null) {
          clearInterval(doctorInterval);
        }
      });
    </script>

