          </div>
          <div class="snapshot-meta">
            <span class="meta-item">
              <span class="meta-label">Cập nhật:</span>
              <strong id="snap-updated-at" class="mono-text">--</strong>
            </span>
            <span class="meta-item">
              <span class="meta-label">Agent gần nhất:</span>
              <span id="snap-last-agent" class="agent-tag">--</span>
            </span>
          </div>
        </div>

        <div class="snapshot-focus-box">
          <div class="focus-title">TRỌNG TÂM HIỆN TẠI (CURRENT FOCUS):</div>
          <div class="focus-text" id="snap-current-focus">Đang tải trạng thái tiến độ từ backend (:8765)...</div>
        </div>

        <div class="next-action-callout">
          <div class="action-icon">👉</div>
          <div class="action-body">
            <div class="action-title">HÀNH ĐỘNG KẾ TIẾP (KHI USER BẢO "LÀM TIẾP"):</div>
            <div class="action-text" id="snap-next-action">Đang đọc dữ liệu...</div>
          </div>
        </div>
      </div>

      <!-- Checklist Split Grid: Completed vs Missing Items -->
      <div class="checklist-grid">
        <!-- Left: Completed Items -->
        <div class="checklist-panel card-sub">
          <div class="panel-card-header">
            <div class="header-title-wrap">
              <span class="panel-tag text-success">COMPLETED ITEMS</span>
              <h4>Các hạng mục đã hoàn thành (<span id="count-completed">0</span>)</h4>
            </div>
            <span class="badge-status status-success">Đã nghiệm thu</span>
          </div>
          <ul class="checklist-items" id="list-completed">
            <li class="loading-item">Đang tải danh sách hạng mục hoàn thành...</li>
          </ul>
        </div>

        <!-- Right: Missing & Pending Items -->
        <div class="checklist-panel card-sub">
          <div class="panel-card-header">
            <div class="header-title-wrap">
              <span class="panel-tag text-warning">MISSING &amp; PENDING</span>
              <h4>Các hạng mục còn thiếu &amp; đang chờ (<span id="count-missing">0</span>)</h4>
            </div>
            <span class="badge-status status-pending">Đang theo dõi</span>
          </div>
          <ul class="checklist-items" id="list-missing">
            <li class="loading-item">Đang tải danh sách hạng mục còn thiếu...</li>
          </ul>
        </div>
      </div>

      <!-- Session Handoff Log Timeline -->
      <div class="sessions-panel card-sub">
        <div class="panel-card-header">
          <div class="header-title-wrap">
            <span class="panel-tag">SESSION HANDOFF LEDGER</span>
            <h4>Nhật ký Bàn giao Phiên làm việc (Session Handoff Log)</h4>
          </div>
          <button type="button" id="btn-refresh-progress" class="btn btn-secondary btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
            </svg>
            <span>Làm mới</span>
