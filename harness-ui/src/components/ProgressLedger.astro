              <option value="">Tất cả nguồn/vai trò</option>
              <option value="supervisor">Supervisor</option>
              <option value="lead">Lead</option>
              <option value="peer">Peer</option>
              <option value="qc">QC</option>
              <option value="paseo-claude">Paseo Claude</option>
              <option value="codex">Codex CLI</option>
            </select>
          </div>
        </div>

        <div class="threads-table-container">
          <table class="threads-table">
            <thead>
              <tr>
                <th>Thread ID</th>
                <th>Nguồn / Vai trò</th>
                <th>Kích thước</th>
                <th>Cập nhật gần nhất</th>
                <th>Đường dẫn file .jsonl</th>
                <th style="text-align: right;">Thao tác</th>
              </tr>
            </thead>
            <tbody id="threads-tbody">
              <tr class="loading-row">
                <td colspan="6">Đang quét các luồng hội thoại .jsonl...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  )}

  { (view === 'all' || view === 'specs') && (
    <div class="spec-portal-section" id="spec-portal-wrap">
      <div class="spec-portal-layout">
        <aside class="spec-sidebar card-sub">
          <div class="sidebar-header">
            <span class="panel-tag">DOCUMENTATION SPEC PORTAL</span>
            <h4>Danh mục Đặc tả (docs/spec/*.md)</h4>
          </div>
          <div class="spec-nav-list" id="spec-nav-links">
            { specDocs.map((doc, idx) => (
              <button
                type="button"
                class={`spec-nav-item ${idx === 0 ? 'active' : ''}`}
                data-slug={doc.slug}
                data-title={doc.title}
