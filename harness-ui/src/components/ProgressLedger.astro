              <span class="spec-path-label" id="current-spec-path">{specDocs[0]?.relPath || ''}</span>
            </div>
            <div class="viewer-actions">
              <button type="button" id="btn-copy-spec-md" class="btn btn-secondary btn-sm" title="Sao chép Markdown">
                Sao chép Markdown
              </button>
            </div>
          </div>

          <article class="markdown-body" id="spec-markdown-content">
          </article>
        </main>
      </div>
    </div>
  )}

  <!-- Modal: Context Window Message Viewer -->
  { (view === 'all' || view === 'ledger') && (
    <dialog id="dlg-thread-viewer" class="dashboard-dialog" aria-labelledby="dlg-thread-title">
      <div class="dialog-card thread-viewer-card">
        <div class="dialog-header">
          <div class="dialog-title-area">
            <div class="dialog-tags">
              <span class="mono-badge" id="tv-thread-id">Thread: --</span>
              <span class="src-tag src-local" id="tv-thread-source">source</span>
              <span class="pill st-Active" id="tv-message-count">0 messages</span>
            </div>
            <h3 id="dlg-thread-title">Context Window Messages Inspector</h3>
            <span class="thread-path-text" id="tv-thread-path">/path/to/thread.jsonl</span>
          </div>
          <button type="button" class="btn-close-dialog" id="btn-close-tv" aria-label="Đóng">&times;</button>
        </div>

        <div class="dialog-body">
          <div class="messages-container" id="tv-messages-list">
            <div class="loading-state">Đang tải và trích xuất tin nhắn hội thoại từ file .jsonl...</div>
          </div>
        </div>

        <div class="dialog-footer">
          <span class="footer-hint">Hiển thị các turns trao đổi giữa user, assistant và system tools</span>
          <button type="button" id="btn-close-tv-footer" class="btn btn-secondary btn-sm">Đóng</button>
        </div>
      </div>
    </dialog>
  )}
</div>

<!-- Embedded Specs Data for Client-Side Fast Rendering -->
{ (view === 'all' || view === 'specs') && (
  <script define:vars={{ specDocs }}>
    window.__HARNESS_SPECS__ = specDocs;
  </script>
)}

<script>
  interface ProgressSession {
    timestamp: string;
    agent: string;
    summary: string;
    done?: string[];
    files?: string[];
    next?: string;
  }

  interface ThreadRecord {
    thread_id: string;
    source: string;
    role?: string;
    path: string;
    size_kb: number;
    mtime?: number;
    updated_at: string;
  }

  interface ThreadMessage {
    role?: string;
    text: string;
  }

  interface ProgressData {
    updated_at: string;
    current_focus: string;
    last_agent: string;
    next_action: string;
    completed_items: string[];
    missing_items: string[];
    sessions?: ProgressSession[];
    threads?: ThreadRecord[];
  }

  interface SpecDocClient {
    slug: string;
    title: string;
    relPath: string;
    size: number;
    content: string;
  }

  declare global {
    interface Window {
      __HARNESS_SPECS__?: SpecDocClient[];
    }
  }

  let cachedProgress: ProgressData | null = null;
  let allThreads: ThreadRecord[] = [];

  function escHtml(s: unknown): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // Lightweight Client-side Markdown Formatter for Specs & Messages
  function renderMarkdownToHtml(md: string): string {
    if (!md) return '<p><em>(Không có nội dung)</em></p>';

    // Escape HTML first for security
    let out = escHtml(md);

    // Code blocks: ```lang ... ```
    out = out.replace(/```([a-zA-Z0-9_\-\+]*)\n([\s\S]*?)```/g, (_m, lang, code) => {
      return `<div class="md-code-block"><div class="md-code-header">${lang || 'code'}</div><pre><code>${code}</code></pre></div>`;
    });

    // Inline code: `code`
    out = out.replace(/`([^`]+)`/g, '<code class="md-inline-code">$1</code>');

    // Headings
    out = out.replace(/^######\s+(.+)$/gm, '<h6>$1</h6>');
    out = out.replace(/^#####\s+(.+)$/gm, '<h5>$1</h5>');
    out = out.replace(/^####\s+(.+)$/gm, '<h4>$1</h4>');
    out = out.replace(/^###\s+(.+)$/gm, '<h3>$1</h3>');
    out = out.replace(/^##\s+(.+)$/gm, '<h2>$1</h2>');
    out = out.replace(/^#\s+(.+)$/gm, '<h1>$1</h1>');

    // Blockquotes
    out = out.replace(/^>\s+(.+)$/gm, '<blockquote>$1</blockquote>');

    // Bold & Italic
    out = out.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    out = out.replace(/\*([^*]+)\*/g, '<em>$1</em>');

    // Horizontal Rules
    out = out.replace(/^---$/gm, '<hr class="md-divider" />');

    // Lists: unordered
    out = out.replace(/^[-*]\s+\[x\]\s+(.+)$/gm, '<li class="task-done"><span class="chk">✓</span> $1</li>');
    out = out.replace(/^[-*]\s+\[\s*\]\s+(.+)$/gm, '<li class="task-pending"><span class="chk">○</span> $1</li>');
    out = out.replace(/^[-*]\s+(.+)$/gm, '<li>$1</li>');

    // Wrap list items
    out = out.replace(/(<li[\s\S]*?<\/li>\n?)+/g, '<ul>$&</ul>');

    // Tables: simple detection
    out = out.replace(/(\|[^\n]+\|\n)+/g, (tbl) => {
      const lines = tbl.trim().split('\n');
      if (lines.length < 2) return tbl;
      let html = '<div class="md-table-wrap"><table class="md-table">';
      lines.forEach((line, i) => {
        if (line.includes('---')) return; // separator
        const cells = line
          .split('|')
          .slice(1, -1)
          .map((c) => c.trim());
        const tag = i === 0 ? 'th' : 'td';
        html += '<tr>' + cells.map((c) => `<${tag}>${c}</${tag}>`).join('') + '</tr>';
      });
      html += '</table></div>';
      return html;
    });

    // Paragraphs
    out = out
      .split('\n\n')
      .map((block) => {
        block = block.trim();
        if (
          block.startsWith('<h') ||
          block.startsWith('<ul') ||
          block.startsWith('<blockquote') ||
          block.startsWith('<div') ||
          block.startsWith('<hr')
        ) {
          return block;
        }
        return `<p>${block.replace(/\n/g, '<br />')}</p>`;
      })
      .join('\n');

    return out;
  }

  // Update Progress Ledger Views
  function updateLedgerDOM(data: ProgressData) {
    cachedProgress = data;

    // Snapshot Overview
    const elUpdated = document.getElementById('snap-updated-at');
    const elAgent = document.getElementById('snap-last-agent');
    const elFocus = document.getElementById('snap-current-focus');
    const elNext = document.getElementById('snap-next-action');

    if (elUpdated) elUpdated.textContent = data.updated_at || 'Vừa xong';
    if (elAgent) elAgent.textContent = data.last_agent || 'Paseo Agent';
    if (elFocus) elFocus.textContent = data.current_focus || '(Chưa có thông tin trọng tâm)';
    if (elNext) elNext.textContent = data.next_action || '(Chưa có hành động tiếp theo)';

    // Completed items checklist
    const elCompletedList = document.getElementById('list-completed');
    const elCountCompleted = document.getElementById('count-completed');
    const completed = data.completed_items || [];
    if (elCountCompleted) elCountCompleted.textContent = String(completed.length);
    if (elCompletedList) {
      if (completed.length === 0) {
        elCompletedList.innerHTML = '<li class="empty-item">Chưa có hạng mục nào được ghi nhận hoàn tất.</li>';
      } else {
        elCompletedList.innerHTML = completed
          .map((item) => `
            <li class="checklist-item done">
              <span class="chk-icon">✓</span>
              <span class="item-text">${escHtml(item)}</span>
            </li>`)
          .join('');
      }
    }

    // Missing items checklist
    const elMissingList = document.getElementById('list-missing');
    const elCountMissing = document.getElementById('count-missing');
    const missing = data.missing_items || [];
    if (elCountMissing) elCountMissing.textContent = String(missing.length);
    if (elMissingList) {
      if (missing.length === 0) {
        elMissingList.innerHTML = '<li class="checklist-item all-done">🎉 Tất cả các hạng mục đều đã hoàn tất!</li>';
      } else {
        elMissingList.innerHTML = missing
          .map((item, idx) => `
            <li class="checklist-item pending">
              <span class="missing-badge">[M${idx + 1}]</span>
              <span class="item-text">${escHtml(item)}</span>
            </li>`)
          .join('');
      }
    }

    // Sessions Timeline
    const elSessions = document.getElementById('sessions-container');
    const sessions = data.sessions || [];
    if (elSessions) {
      if (sessions.length === 0) {
        elSessions.innerHTML = '<div class="empty-sessions">Chưa có phiên làm việc nào được ghi nhận trong lịch sử.</div>';
      } else {
        elSessions.innerHTML = sessions
          .slice(-8)
          .reverse()
          .map((sess, idx) => {
            const num = sessions.length - idx;
            const doneBullets = (sess.done || []).map((d) => `<li>${escHtml(d)}</li>`).join('');
            const filePills = (sess.files || []).map((f) => `<span class="file-pill">${escHtml(f)}</span>`).join('');

            return `
              <div class="session-card">
                <div class="session-header">
                  <div class="session-title-wrap">
                    <span class="session-num">Phiên #${num}</span>
                    <strong class="session-agent">${escHtml(sess.agent)}</strong>
                  </div>
                  <span class="session-time mono-text">${escHtml(sess.timestamp)}</span>
                </div>
                <div class="session-summary">${escHtml(sess.summary)}</div>
                ${doneBullets ? `<ul class="session-done-list">${doneBullets}</ul>` : ''}
                ${filePills ? `<div class="session-files-wrap"><span class="files-lbl">Files:</span>${filePills}</div>` : ''}
                ${sess.next ? `<div class="session-next"><strong>Kế tiếp:</strong> ${escHtml(sess.next)}</div>` : ''}
              </div>`;
          })
          .join('');
      }
    }

    // Threads List
    if (Array.isArray(data.threads)) {
      allThreads = data.threads;
      renderThreadsTable();
    }
  }

  // Render Threads Table
  function renderThreadsTable() {
    const tbody = document.getElementById('threads-tbody');
    const searchInput = document.getElementById('thread-search') as HTMLInputElement | null;
    const roleFilter = document.getElementById('thread-role-filter') as HTMLSelectElement | null;
    if (!tbody) return;

    const q = (searchInput?.value || '').trim().toLowerCase();
    const roleVal = (roleFilter?.value || '').toLowerCase();

    const filtered = allThreads.filter((t) => {
      if (q) {
        const hay = `${t.thread_id} ${t.source} ${t.role || ''} ${t.path}`.toLowerCase();
        if (!hay.includes(q)) return false;
      }
      if (roleVal) {
        const r = (t.role || t.source || '').toLowerCase();
        if (!r.includes(roleVal)) return false;
      }
      return true;
    });

    if (filtered.length === 0) {
      tbody.innerHTML = `
        <tr class="empty-row">
          <td colspan="6" style="text-align: center; padding: 24px; color: var(--text-muted);">
            Không tìm thấy luồng ngữ cảnh nào phù hợp.
          </td>
        </tr>`;
      return;
    }

    tbody.innerHTML = filtered.map((t) => {
      const roleName = (t.role || t.source.replace('codex-', '').replace('paseo-', '')).toUpperCase();
      let roleColor = '#0EA5E9';
      if (roleName.includes('SUPERVISOR')) roleColor = '#8B5CF6';
      else if (roleName.includes('LEAD')) roleColor = '#0EA5E9';
      else if (roleName.includes('PEER')) roleColor = '#10B981';
      else if (roleName.includes('QC')) roleColor = '#F59E0B';
      else if (roleName.includes('CLAUDE')) roleColor = '#3B82F6';

      const shortId = t.thread_id.length > 20 ? t.thread_id.slice(0, 18) + '...' : t.thread_id;
      const shortPath = t.path.split('/').slice(-3).join('/');

      return `
        <tr class="thread-row" data-path="${escHtml(t.path)}" data-id="${escHtml(t.thread_id)}">
          <td class="mono-text" style="color: #60A5FA; font-weight: 600;" title="${escHtml(t.thread_id)}">${escHtml(shortId)}</td>
          <td><span class="role-pill" style="border-color:${roleColor}; color:${roleColor}; background:rgba(255,255,255,0.04);">${escHtml(roleName)}</span></td>
          <td class="mono-text">${t.size_kb} KB</td>
          <td class="mono-text" style="font-size: 11.5px; color: var(--text-muted);">${escHtml(t.updated_at)}</td>
          <td class="path-cell" title="${escHtml(t.path)}">${escHtml(shortPath)}</td>
          <td style="text-align: right;" onclick="event.stopPropagation()">
            <button type="button" class="btn btn-sm btn-secondary btn-inspect-thread" data-path="${escHtml(t.path)}" data-id="${escHtml(t.thread_id)}">
              Xem tin nhắn
            </button>
          </td>
        </tr>`;
    }).join('');

    tbody.querySelectorAll<HTMLButtonElement>('.btn-inspect-thread').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const path = btn.dataset.path;
        const id = btn.dataset.id;
        if (path) openThreadViewer(path, id || '');
      });
    });

    tbody.querySelectorAll<HTMLTableRowElement>('.thread-row').forEach((tr) => {
      tr.addEventListener('click', () => {
        const path = tr.dataset.path;
        const id = tr.dataset.id;
        if (path) openThreadViewer(path, id || '');
      });
    });
  }

  // Open Context Window Message Viewer Modal
  async function openThreadViewer(threadPath: string, threadId: string) {
    const dlg = document.getElementById('dlg-thread-viewer') as HTMLDialogElement | null;
    const tvId = document.getElementById('tv-thread-id');
    const tvSrc = document.getElementById('tv-thread-source');
    const tvCount = document.getElementById('tv-message-count');
    const tvPath = document.getElementById('tv-thread-path');
    const msgList = document.getElementById('tv-messages-list');

    if (!dlg) return;

    if (tvId) tvId.textContent = `Thread: ${threadId || 'session'}`;
    if (tvPath) tvPath.textContent = threadPath;
    if (tvSrc) tvSrc.textContent = threadPath.includes('codex') ? 'codex' : 'claude';
    if (msgList) msgList.innerHTML = '<div class="loading-state">Đang trích xuất turns tin nhắn từ file .jsonl...</div>';

    dlg.showModal();

    try {
      const url = `/api/progress?thread=${encodeURIComponent(threadPath)}&t=${Date.now()}`;
      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      const messages: ThreadMessage[] = data.messages || data.thread_detail?.messages || [];
      const totalCount = data.total_extracted_messages || messages.length;

      if (tvCount) tvCount.textContent = `${totalCount} messages`;

      if (!msgList) return;

      if (messages.length === 0) {
        msgList.innerHTML = '<div class="empty-state">Không trích xuất được tin nhắn text nào từ file session này.</div>';
        return;
      }

      msgList.innerHTML = messages.map((m) => {
        const role = (m.role || 'user').toLowerCase();
        let roleBadgeColor = '#3B82F6';
        if (role === 'assistant') roleBadgeColor = '#10B981';
        else if (role === 'system') roleBadgeColor = '#94A3B8';
        else if (role === 'supervisor') roleBadgeColor = '#8B5CF6';
        else if (role === 'lead') roleBadgeColor = '#0EA5E9';
        else if (role === 'peer') roleBadgeColor = '#10B981';
        else if (role === 'qc') roleBadgeColor = '#F59E0B';

        const formatted = renderMarkdownToHtml(m.text);

        return `
          <div class="thread-message-item role-${escHtml(role)}">
            <div class="msg-header">
              <span class="msg-role-pill" style="border-color:${roleBadgeColor}; color:${roleBadgeColor};">
                ${escHtml(role.toUpperCase())}
              </span>
            </div>
            <div class="msg-content">${formatted}</div>
          </div>`;
      }).join('');

      msgList.scrollTop = msgList.scrollHeight;
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : String(err);
      if (msgList) {
        msgList.innerHTML = `<div class="error-state">Lỗi đọc thread: ${escHtml(message)}</div>`;
      }
    }
  }

  // Fetch Progress Data from Backend
  async function loadProgressData() {
    try {
      const res = await fetch('/api/progress?t=' + Date.now());
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data: ProgressData = await res.json();
      updateLedgerDOM(data);
    } catch {
      // Fallback display if backend is offline
      const elFocus = document.getElementById('snap-current-focus');
      if (elFocus && !cachedProgress) {
        elFocus.textContent = 'Mất kết nối backend (:8765). Đang chờ tín hiệu phục hồi...';
      }
    }
  }

  // Spec Portal Management
  function initSpecPortal() {
    const specs = window.__HARNESS_SPECS__ || [];
    if (specs.length === 0) return;

    let activeSlug = specs[0]?.slug || '';

    function renderSpec(slug: string) {
      const doc = specs.find((s) => s.slug === slug) || specs[0];
      if (!doc) return;

      activeSlug = doc.slug;

      const titleEl = document.getElementById('current-spec-title');
      const pathEl = document.getElementById('current-spec-path');
      const contentEl = document.getElementById('spec-markdown-content');

      if (titleEl) titleEl.textContent = doc.title;
      if (pathEl) pathEl.textContent = doc.relPath;
      if (contentEl) {
        contentEl.innerHTML = renderMarkdownToHtml(doc.content);
      }

      // Update active nav button
      document.querySelectorAll<HTMLButtonElement>('.spec-nav-item').forEach((btn) => {
        if (btn.dataset.slug === slug) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    // Attach click handlers to spec nav items
    document.querySelectorAll<HTMLButtonElement>('.spec-nav-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.slug;
        if (slug) renderSpec(slug);
      });
    });

    // Copy markdown content
    document.getElementById('btn-copy-spec-md')?.addEventListener('click', () => {
      const doc = specs.find((s) => s.slug === activeSlug);
      if (doc && doc.content) {
        navigator.clipboard.writeText(doc.content).then(() => {
          const btn = document.getElementById('btn-copy-spec-md');
          if (btn) {
            btn.textContent = 'Đã sao chép!';
            setTimeout(() => {
              btn.textContent = 'Sao chép Markdown';
            }, 1500);
          }
        });
      }
    });

    // Initial render
    renderSpec(activeSlug);
  }

  // Setup Main Events
  function setupEvents() {
    // Refresh button
    document.getElementById('btn-refresh-progress')?.addEventListener('click', loadProgressData);

    // Threads filters
    document.getElementById('thread-search')?.addEventListener('input', renderThreadsTable);
    document.getElementById('thread-role-filter')?.addEventListener('change', renderThreadsTable);

    // Thread Viewer Dialog Close
    const dlgTv = document.getElementById('dlg-thread-viewer') as HTMLDialogElement | null;
    document.getElementById('btn-close-tv')?.addEventListener('click', () => dlgTv?.close());
    document.getElementById('btn-close-tv-footer')?.addEventListener('click', () => dlgTv?.close());
  }

  function initProgressLedger() {
    setupEvents();
    loadProgressData();
    initSpecPortal();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProgressLedger);
  } else {
    initProgressLedger();
  }
</script>

