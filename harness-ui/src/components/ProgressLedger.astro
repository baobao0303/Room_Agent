---
// @ts-ignore
import fs from 'node:fs';
// @ts-ignore
import path from 'node:path';

declare const process: { cwd(): string };

interface Props {
  view?: 'all' | 'ledger' | 'specs';
}

const { view = 'all' } = Astro.props;

// Read specs statically at build time
interface SpecDoc {
  slug: string;
  title: string;
  relPath: string;
  size: number;
  content: string;
}

let specDocs: SpecDoc[] = [];

if (view === 'all' || view === 'specs') {
  try {
    const specDir = path.resolve(process.cwd(), '../docs/spec');
    if (fs.existsSync(specDir)) {
      function readDirRecursive(d: string): SpecDoc[] {
        const results: SpecDoc[] = [];
        const entries = fs.readdirSync(d, { withFileTypes: true });
        for (const entry of entries) {
          const full = path.join(d, entry.name);
          if (entry.isDirectory()) {
            results.push(...readDirRecursive(full));
          } else if (entry.isFile() && entry.name.endsWith('.md')) {
            const rel = path.relative(specDir, full);
            const raw = fs.readFileSync(full, 'utf-8');
            // Extract first H1 title if present
            const titleMatch = raw.match(/^#\s+(.+)$/m);
            const title = titleMatch ? titleMatch[1].trim() : entry.name.replace('.md', '');
            results.push({
              slug: rel.replace(/\.md$/, ''),
              title,
              relPath: rel,
              size: raw.length,
              content: raw,
            });
          }
        }
        return results;
      }

      specDocs = readDirRecursive(specDir);
    }
  } catch (e) {
    console.warn('[ProgressLedger] Could not read docs/spec:', e);
  }
}
---

<div class={`progress-ledger-island view-${view}`}>
  { (view === 'all' || view === 'ledger') && (
    <div class="ledger-view-section" id="ledger-content-wrap">
      <!-- Top Overview Snapshot Card -->
      <div class="snapshot-card">
