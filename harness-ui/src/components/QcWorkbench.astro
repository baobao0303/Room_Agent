---
// QcWorkbench.astro - Interactive 5-Stage QC & Test Runner Island
---

<div class="qc-workbench-island">
  <!-- Paseo Multi-Node Connector & Smart Developer Link Auto-Generator -->
  <div class="qc-card-panel paseo-smart-bar">
    <div class="panel-card-header">
      <div class="header-title-wrap">
        <span class="panel-tag">PASEO MULTI-NODE &amp; SMART LINK AUTO-GEN</span>
        <h3>Kết nối Nhiều Máy (Paseo Node) &amp; Dán Link Người Làm Tự Sinh File Test</h3>
      </div>
      <div class="active-node-indicator" id="active-node-badge">
        <span class="pulse-dot"></span>
        <span id="active-node-label">Node: Local / Current Host</span>
      </div>
    </div>

    <div class="paseo-smart-grid">
      <!-- Box 1: Connect Machine / Paseo Host -->
      <div class="smart-subbox">
        <div class="subbox-header">
          <span class="subbox-title">1. KẾT NỐI MÁY TRẠM / PASEO NODE (MULTI-MACHINE)</span>
          <span class="subbox-hint">Dán link máy đích để đọc &amp; ghi file trực tiếp trên máy đó</span>
        </div>
        <div class="node-connect-row">
          <input
            type="text"
            id="paseo-node-url"
            class="mono-input flex-2"
            placeholder="Dán link máy: http://100.92.98.99:8765 hoặc paseo://100.124.36.46:6767"
          />
          <input
            type="text"
            id="paseo-node-name"
            class="mono-input flex-1"
            placeholder="Tên máy (VD: Máy Dev A)"
          />
          <button type="button" id="btn-connect-node" class="btn btn-secondary btn-sm">
            <span>⚡ Kết nối máy</span>
          </button>
        </div>
        <div class="node-chips-list" id="paseo-node-list">
          <!-- Populated dynamically via /api/nodes -->
        </div>
      </div>

      <!-- Box 2: Paste Developer Link -> Auto Read & Generate Spec Files -->
      <div class="smart-subbox">
        <div class="subbox-header">
          <span class="subbox-title">2. DÁN LINK NGƯỜI LÀM / PR / WORK ITEM / FILE URL</span>
          <span class="subbox-hint">Tự động bóc tách file code, chạy 5-Stage ISTQB &amp; ghi file .spec.ts</span>
        </div>
        <div class="smart-link-row">
          <input
            type="text"
            id="smart-dev-link"
            class="mono-input flex-3"
            placeholder="Dán link TFS (?path=...), GitHub PR/Blob, Work Item #159425, hoặc tên người làm..."
          />
          <button type="button" id="btn-smart-resolve" class="btn btn-primary btn-sm">
            <span>🚀 Đọc Link &amp; Tự Tạo File Test</span>
          </button>
        </div>
        <div class="smart-quick-row">
          <div class="demo-links-wrap">
            <span class="quick-label">Thử nhanh:</span>
            <button type="button" class="btn-demo-link" data-link="#159425" title="Work Item #159425 (Le Thien Bao)">#159425 (BaoLT)</button>
            <button type="button" class="btn-demo-link" data-link="#160055" title="Work Item #160055">#160055</button>
            <button type="button" class="btn-demo-link" data-link="https://tfs.First.com/tfs/DefaultCollection/WICX/_git/wicx-crm-fe?path=/libs/wicx-core/src/utils/helps/validator.helper.ts" title="Link TFS ?path=validator.helper.ts">TFS ?path=validator.helper.ts</button>
            <button type="button" class="btn-demo-link" data-link="Le Thien Bao" title="Tìm theo tên người làm">Dev: Le Thien Bao</button>
          </div>
          <label class="checkbox-label">
            <input type="checkbox" id="smart-write-alongside" checked />
            <span>Ghi file <code>.generated.spec.ts</code> cạnh file gốc trên máy đích</span>
          </label>
        </div>
        <div id="smart-link-result" class="smart-link-result" style="display: none;"></div>
      </div>
    </div>
  </div>

  <!-- Top Split Grid: Generator & Test Suite Runner -->
  <div class="qc-top-grid">
    <!-- Panel 1: 5-Stage ISTQB Test Generator -->
    <div class="qc-card-panel generator-panel">
      <div class="panel-card-header">
        <div class="header-title-wrap">
          <span class="panel-tag">5-STAGE ISTQB GENERATOR</span>
          <h3>Trình sinh Unit Test tự động (ISTQB Pipeline)</h3>
        </div>
        <div class="stage-pills-bar">
          <span class="stage-step" title="Stage 1: Phân tích cú pháp & Symbol">S1: AST</span>
          <span class="stage-step" title="Stage 2: Phân vùng tương đương & Biên BVA">S2: BVA</span>
          <span class="stage-step" title="Stage 3: Chuyển đổi trạng thái State">S3: State</span>
          <span class="stage-step" title="Stage 4: Bắt lỗi ngoại lệ Error Guessing">S4: Error</span>
          <span class="stage-step" title="Stage 5: Tổng hợp Assertions">S5: Synth</span>
        </div>
      </div>

      <form id="form-qc-gen" onsubmit="return false;" class="qc-form">
        <div class="form-row">
          <div class="form-group flex-1">
            <label for="qc-source" class="field-label">File nguồn hoặc Link người làm (Source / URL) <span class="req">*</span>:</label>
            <input
              type="text"
              id="qc-source"
              list="dl-sources"
              placeholder="e.g. projects/wicx-crm-fe/libs/wicx-core/src/utils/helps/validator.helper.ts"
              required
            />
            <datalist id="dl-sources"></datalist>
          </div>

          <div class="form-group flex-1">
            <label for="qc-spec" class="field-label">File đặc tả / Tiêu chí AC (Spec file):</label>
            <input
              type="text"
              id="qc-spec"
              list="dl-specs"
              placeholder="e.g. docs/spec/astro-jenkins-harness-ui-spec.md"
            />
            <datalist id="dl-specs"></datalist>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group flex-1">
            <label for="qc-task-id" class="field-label">Work Item ID liên quan (Tùy chọn):</label>
            <input type="number" id="qc-task-id" placeholder="e.g. 161201" />
          </div>

          <div class="form-group flex-1">
            <label for="qc-out-spec" class="field-label">Đường dẫn file test đầu ra (Output spec):</label>
            <input type="text" id="qc-out-spec" value="/tmp/generated.spec.ts" />
          </div>
        </div>

        <div class="form-checkboxes">
          <label class="checkbox-label">
            <input type="checkbox" id="qc-write-alongside" checked />
            <span>Ghi trực tiếp cạnh file gốc (<code>.generated.spec.ts</code>)</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id="qc-sync-harness" checked />
            <span>Tự động đồng bộ Testcase lên Harness DB</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id="qc-run-after" checked />
            <span>Chạy test suite ngay sau khi sinh file</span>
          </label>
        </div>

        <div class="form-actions-row">
          <div id="qc-gen-status" class="status-msg"></div>
          <div class="buttons-wrap">
            <button type="button" id="btn-qc-dispatch-agent" class="btn btn-secondary btn-sm" title="Ủy quyền cho Agent QC xử lý sinh test và tinh chỉnh">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
              <span>Giao Agent QC</span>
            </button>
            <button type="button" id="btn-qc-generate" class="btn btn-primary btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <span>Sinh Unit Test (5-Stage)</span>
            </button>
          </div>
        </div>
      </form>

      <!-- Coverage Metrics & Spec Preview Box -->
      <div id="qc-result-box" class="qc-result-container" style="display: none;">
        <div class="result-header">
          <span class="box-label">KẾT QUẢ ĐỘ PHỦ (COVERAGE METRICS &amp; SPEC PREVIEW):</span>
          <button type="button" id="btn-copy-spec" class="btn-copy" title="Sao chép mã nguồn test">Sao chép code</button>
        </div>
        <div class="coverage-badges" id="qc-cov-badges">
          <!-- Dynamic coverage badges -->
        </div>
        <pre class="terminal-box spec-preview-box" id="qc-spec-preview"></pre>
      </div>
    </div>

    <!-- Panel 2: Test Suite Runner & Presets -->
    <div class="qc-card-panel runner-panel">
      <div class="panel-card-header">
        <div class="header-title-wrap">
          <span class="panel-tag">TEST SUITE RUNNER</span>
          <h3>Thực thi Test Suites &amp; Lệnh CLI kiểm thử</h3>
        </div>
      </div>

      <div class="presets-section">
        <label class="field-label">Presets Kiểm thử &amp; Build (Quick Run):</label>
        <div class="presets-grid" id="preset-container">
          <button type="button" class="btn-preset" data-cmd="python3 tools/test_harness.py" data-cwd="" data-title="Harness Self-Test">
            <span class="preset-name">Harness Self-Test</span>
            <span class="preset-cmd">python3 tools/test_harness.py</span>
          </button>
          <button type="button" class="btn-preset" data-cmd="python3 tools/test_qc_generator.py" data-cwd="" data-title="QC Generator Test">
            <span class="preset-name">QC Generator Test</span>
            <span class="preset-cmd">python3 tools/test_qc_generator.py</span>
          </button>
          <button type="button" class="btn-preset" data-cmd="npx vitest run" data-cwd="game" data-title="Game Vitest Suite">
            <span class="preset-name">Game Vitest Suite</span>
            <span class="preset-cmd">npx vitest run (game)</span>
          </button>
          <button type="button" class="btn-preset" data-cmd="npm run build" data-cwd="harness-ui" data-title="Astro Harness UI Build">
            <span class="preset-name">Astro UI Build</span>
            <span class="preset-cmd">npm run build (harness-ui)</span>
          </button>
        </div>
      </div>

      <div class="custom-cmd-section">
        <label class="field-label">Lệnh CLI kiểm thử tùy chỉnh (Custom Test Command):</label>
        <div class="cmd-input-row">
          <div class="form-group flex-3">
            <input
              type="text"
              id="custom-cmd-input"
              placeholder="e.g. npx vitest run or python3 tools/test_harness.py"
              class="mono-input"
            />
          </div>
          <div class="form-group flex-1">
            <input
              type="text"
              id="custom-cwd-input"
              placeholder="CWD (e.g. game)"
              class="mono-input"
            />
          </div>
          <button type="button" id="btn-run-custom" class="btn btn-primary btn-sm">
            <span>Chạy</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Live Streaming Background Jobs Console -->
  <div class="qc-card-panel terminal-panel">
    <div class="panel-card-header">
      <div class="header-title-wrap">
        <div class="live-pulse-badge">
          <span class="pulse-dot"></span>
          <span>LIVE AUTOMATION JOBS STREAM</span>
        </div>
        <h4>Đầu ra Console &amp; Tiến trình Thực thi nền (Job Stream)</h4>
      </div>

      <div class="job-stream-actions">
        <div class="job-pills-bar" id="job-list">
          <!-- Dynamic job tabs -->
        </div>
        <button type="button" id="btn-refresh-jobs" class="btn btn-secondary btn-sm" title="Làm mới log">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
          </svg>
          <span>Làm mới</span>
        </button>
      </div>
    </div>

    <div class="terminal-box terminal-stream" id="job-terminal">
[READY] QC Automation Console đã sẵn sàng.
Chưa có tác vụ kiểm thử nào đang chạy. Chọn một Preset hoặc ấn "Sinh Unit Test" phía trên để khởi động.
    </div>
  </div>
</div>

<script>
  interface PresetItem {
    title: string;
    command: string;
    cwd?: string;
  }

  interface AutomationJob {
    id: string;
    kind?: string;
    title: string;
    status: 'running' | 'passed' | 'failed' | string;
    elapsed: number | string;
    exit_code?: number | null;
    output?: string;
  }

  interface CoverageReport {
    total_cases?: number;
    requirement_coverage_pct?: number;
    coverage_item_pct?: number;
    symbol_coverage_pct?: number;
  }

  interface QcGenerateResponse {
    coverage_report?: CoverageReport;
    spec_code?: string;
    out_spec?: string;
    synced_count?: number;
    job_id?: string;
    error?: string;
  }

  interface PaseoNodeItem {
    id: string;
    name: string;
    url: string;
    paseo_url?: string;
    workspace?: string;
    status?: string;
    latency_ms?: number;
  }

  interface GeneratedFileEntry {
    source_file: string;
    out_spec: string;
    written_on_disk?: boolean;
    total_cases: number;
    requirement_coverage_pct?: number;
    coverage_item_pct?: number;
    symbol_coverage_pct?: number;
    synced_to_harness?: number;
    spec_code?: string;
  }

  interface SmartLinkResponse {
    ok?: boolean;
    input_link?: string;
    link_kind?: string;
    task_id?: number | null;
    developer?: string;
    target_node?: string;
    workspace?: string;
    discovered_sources?: string[];
    generated_files?: GeneratedFileEntry[];
    total_cases_generated?: number;
    total_synced_to_harness?: number;
    coverage_report?: CoverageReport;
    spec_code?: string;
    out_spec?: string;
    job_id?: string;
    error?: string;
  }

  let activeJobId: string | null = null;
  let qcJobPollInterval: number | null = null;

  function getActivePaseoNode(): string {
    try {
      const win = window as unknown as Record<string, unknown>;
      return String(win['__PASEO_ACTIVE_NODE__'] || localStorage.getItem('paseo_active_node') || '').trim();
    } catch {
      return '';
    }
  }

  function setActivePaseoNode(url: string, label = '') {
    try {
      const win = window as unknown as Record<string, (u: string) => void>;
      if (typeof win['__PASEO_SET_NODE__'] === 'function') {
        win['__PASEO_SET_NODE__'](url);
      } else {
        localStorage.setItem('paseo_active_node', url);
      }
    } catch {
      // ignore storage errors
    }
    const badgeLabel = document.getElementById('active-node-label');
    if (badgeLabel) {
      badgeLabel.textContent = url
        ? `Node đang chọn: ${label || url} (${url})`
        : 'Node đang chọn: Máy hiện tại (Local/Default)';
    }
    loadSourceFilesAndPresets();
    pollJobs();
  }

  async function loadPaseoNodes() {
    const listEl = document.getElementById('paseo-node-list');
    if (!listEl) return;
    try {
      const res = await fetch('/api/nodes?t=' + Date.now());
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const nodes: PaseoNodeItem[] = Array.isArray(data.nodes) ? data.nodes : [];
      const activeUrl = getActivePaseoNode();

      const badgeLabel = document.getElementById('active-node-label');
      if (badgeLabel) {
        const matched = nodes.find((n) => n.url === activeUrl);
        badgeLabel.textContent = matched
          ? `Node: ${matched.name} (${matched.url}) — WS: ${matched.workspace || data.current_workspace || ''}`
          : activeUrl
            ? `Node: ${activeUrl}`
            : `Node: Local Host (${data.current_workspace || '/home/baoltb/Desktop/Paseo_Project'})`;
      }

      listEl.innerHTML = nodes
        .map((n) => {
          const isOnline = n.status === 'online';
          const isSelected = activeUrl ? n.url === activeUrl : n.id === 'local';
          const lat = n.latency_ms !== undefined ? `${n.latency_ms}ms` : '';
          return `<button type="button" class="node-chip ${isOnline ? 'online' : 'offline'} ${isSelected ? 'selected' : ''}" data-node-url="${escHtml(n.url)}" data-node-name="${escHtml(n.name)}" title="Workspace: ${escHtml(n.workspace || '')} | Click để chuyển sang máy này">
            <span class="node-dot"></span>
            <span class="node-chip-name">${escHtml(n.name)}</span>
            <span class="node-chip-url">${escHtml(n.url)}</span>
            ${lat ? `<span class="node-chip-lat">${escHtml(lat)}</span>` : ''}
          </button>`;
        })
        .join('');

      listEl.querySelectorAll<HTMLButtonElement>('.node-chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          const url = btn.dataset.nodeUrl || '';
          const name = btn.dataset.nodeName || url;
          setActivePaseoNode(url, name);
          loadPaseoNodes();
        });
      });
    } catch {
      // Fallback node chip
    }
  }

  function escHtml(s: unknown): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // Load Source Files, Specs, and Presets
  async function loadSourceFilesAndPresets() {
    try {
      const res = await fetch('/api/source-files?t=' + Date.now());
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      // Datalists
      const dlSources = document.getElementById('dl-sources');
      const dlSpecs = document.getElementById('dl-specs');
      if (dlSources && Array.isArray(data.sources)) {
        dlSources.innerHTML = data.sources.map((s: string) => `<option value="${escHtml(s)}">`).join('');
      }
      if (dlSpecs && Array.isArray(data.specs)) {
        dlSpecs.innerHTML = data.specs.map((s: string) => `<option value="${escHtml(s)}">`).join('');
      }

      // Presets
      const presetContainer = document.getElementById('preset-container');
      if (presetContainer && Array.isArray(data.presets) && data.presets.length > 0) {
        presetContainer.innerHTML = data.presets
          .map((p: PresetItem) => {
            return `<button type="button" class="btn-preset" data-cmd="${escHtml(p.command)}" data-cwd="${escHtml(p.cwd || '')}" data-title="${escHtml(p.title)}">
              <span class="preset-name">${escHtml(p.title)}</span>
              <span class="preset-cmd">${escHtml(p.command)}</span>
            </button>`;
          })
          .join('');

        // Attach click handlers to newly created preset buttons
        presetContainer.querySelectorAll<HTMLButtonElement>('.btn-preset').forEach((btn) => {
          btn.addEventListener('click', () => {
            const title = btn.dataset.title || 'Command';
            const cmd = btn.dataset.cmd || '';
            const cwd = btn.dataset.cwd || '';
            runAutomationJob(title, cmd, cwd);
          });
        });
      }
    } catch {
      // Fallback presets retained
    }
  }

  // Run Automation Job via API
  async function runAutomationJob(title: string, command: string, cwd = '') {
    if (!command.trim()) {
      alert('Vui lòng chỉ định lệnh cần thực thi!');
      return;
    }

    try {
      const payload = {
        kind: 'automation',
        title: title,
        command: command.trim(),
        cwd: cwd.trim(),
      };

      const res = await fetch('/api/automation/run', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.error || `HTTP ${res.status}`);
      }

      const job: AutomationJob = await res.json();
      activeJobId = job.id;
      await pollJobs();
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : String(err);
      alert('Không thể khởi chạy job: ' + message);
    }
  }

  // Poll Jobs for Console Terminal
  async function pollJobs() {
    try {
      const res = await fetch('/api/automation/jobs?t=' + Date.now());
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const jobs: AutomationJob[] = await res.json();
      const listEl = document.getElementById('job-list');
      const term = document.getElementById('job-terminal');

      if (!jobs || jobs.length === 0) {
        if (listEl) listEl.innerHTML = '';
        return;
      }

      if (!activeJobId || !jobs.some((j) => j.id === activeJobId)) {
        activeJobId = jobs[0].id;
      }

      if (listEl) {
        listEl.innerHTML = jobs
          .slice(0, 6)
          .map((j) => {
            const isRun = j.status === 'running';
            const isPass = j.status === 'passed';
            const stTxt = isRun ? '[Đang chạy]' : isPass ? '[OK]' : '[Lỗi]';
            const stClass = isRun ? 'running' : isPass ? 'passed' : 'failed';
            const activeClass = j.id === activeJobId ? 'active-job' : '';

            return `<button type="button" class="job-pill ${stClass} ${activeClass}" data-job-id="${j.id}">
              ${stTxt} ${escHtml(j.title.slice(0, 24))} (${j.elapsed}s)
            </button>`;
          })
          .join('');

        listEl.querySelectorAll<HTMLButtonElement>('.job-pill').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.dataset.jobId;
            if (id) {
              activeJobId = id;
              pollJobs();
            }
          });
        });
      }

      if (term) {
        const cur = jobs.find((j) => j.id === activeJobId) || jobs[0];
        if (cur) {
          const header = `[JOB: ${cur.id}] STATUS: ${cur.status.toUpperCase()} | ELAPSED: ${cur.elapsed}s | ${cur.title}\n`;
          const sep = '================================================================================\n';
          term.textContent = header + sep + (cur.output || '(Chưa có dữ liệu đầu ra console)');
          term.scrollTop = term.scrollHeight;
        }
      }
    } catch {
      // Keep console display
    }
  }

  // Setup Event Listeners
  function setupQcEvents() {
    // 1. Connect Remote Paseo / Harness Machine Node
    const btnConnectNode = document.getElementById('btn-connect-node') as HTMLButtonElement | null;
    btnConnectNode?.addEventListener('click', async () => {
      const urlInput = document.getElementById('paseo-node-url') as HTMLInputElement | null;
      const nameInput = document.getElementById('paseo-node-name') as HTMLInputElement | null;
      const rawUrl = urlInput?.value.trim() || '';
      const rawName = nameInput?.value.trim() || '';

      if (!rawUrl) {
        alert('Vui lòng dán link máy trạm hoặc Paseo Node (VD: http://100.92.98.99:8765)!');
        urlInput?.focus();
        return;
      }

      if (btnConnectNode) {
        btnConnectNode.disabled = true;
        btnConnectNode.textContent = 'Đang kết nối...';
      }

      try {
        const res = await fetch('/api/nodes/connect', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: rawUrl, name: rawName }),
        });
        const data = await res.json();
        if (data.node && data.node.url) {
          setActivePaseoNode(data.node.url, data.node.name || rawName);
        }
        await loadPaseoNodes();
        if (urlInput) urlInput.value = '';
        if (nameInput) nameInput.value = '';
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : String(err);
        alert('Lỗi kết nối máy: ' + msg);
      } finally {
        if (btnConnectNode) {
          btnConnectNode.disabled = false;
          btnConnectNode.innerHTML = '<span>⚡ Kết nối máy</span>';
        }
      }
    });

    // 2. Demo Link Quick Pills
    document.querySelectorAll<HTMLButtonElement>('.btn-demo-link').forEach((btn) => {
      btn.addEventListener('click', () => {
        const link = btn.dataset.link || '';
        const input = document.getElementById('smart-dev-link') as HTMLInputElement | null;
        if (input && link) {
          input.value = link;
          document.getElementById('btn-smart-resolve')?.click();
        }
      });
    });

    // 3. Smart Developer Link Auto-Reader & Test File Generator
    const btnSmartResolve = document.getElementById('btn-smart-resolve') as HTMLButtonElement | null;
    btnSmartResolve?.addEventListener('click', async () => {
      const linkInput = document.getElementById('smart-dev-link') as HTMLInputElement | null;
      const writeAlongside = document.getElementById('smart-write-alongside') as HTMLInputElement | null;
      const resultBox = document.getElementById('smart-link-result');
      const rawLink = linkInput?.value.trim() || '';

      if (!rawLink) {
        alert('Vui lòng dán link PR / Commit / TFS ?path= / Work Item #ID hoặc tên người làm!');
        linkInput?.focus();
        return;
      }

      if (btnSmartResolve) {
        btnSmartResolve.disabled = true;
        btnSmartResolve.textContent = '⏳ Đang đọc link & tạo file...';
      }

      try {
        const payload = {
          link: rawLink,
          write_alongside: Boolean(writeAlongside?.checked),
          sync_harness: true,
          run_test: true,
          target_node: getActivePaseoNode(),
        };

        const res = await fetch('/api/automation/resolve-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || `HTTP ${res.status}`);
        }

        const data: SmartLinkResponse = await res.json();
        const files = data.generated_files || [];

        if (resultBox) {
          resultBox.style.display = 'flex';
          const fileRows = files
            .map(
              (f) =>
                `<div class="gen-file-item">
                  <span class="gen-badge">✓ WRITTEN</span>
                  <code class="gen-src">${escHtml(f.source_file)}</code>
                  <span class="gen-arrow">→</span>
                  <code class="gen-out">${escHtml(f.out_spec)}</code>
                  <span class="gen-meta">(${f.total_cases} cases | REQ ${f.requirement_coverage_pct ?? 100}%)</span>
                </div>`
            )
            .join('');

          resultBox.innerHTML = `
            <div class="smart-res-summary">
              <strong>[AUTO-GEN HOÀN TẤT]</strong> Loại link: <code>${escHtml(data.link_kind)}</code>
              ${data.developer ? `| Người làm: <strong>${escHtml(data.developer)}</strong>` : ''}
              ${data.task_id ? `| Work Item: <strong>#${data.task_id}</strong>` : ''}
              | Đã tạo <strong>${files.length}</strong> file test (<strong>${data.total_cases_generated ?? 0}</strong> ISTQB cases) trên workspace <code>${escHtml(data.workspace || 'local')}</code>
            </div>
            <div class="gen-files-list">${fileRows}</div>
          `;
        }

        // Also populate the main Coverage & Spec Preview box below
        const cov = data.coverage_report || {};
        const resBox = document.getElementById('qc-result-box');
        const badges = document.getElementById('qc-cov-badges');
        const preview = document.getElementById('qc-spec-preview');

        if (resBox) resBox.style.display = 'flex';
        if (badges) {
          badges.innerHTML = `
            <span class="cov-badge">Files Generated: <strong>${files.length}</strong></span>
            <span class="cov-badge">Total Cases: <strong>${data.total_cases_generated ?? cov.total_cases ?? 0}</strong></span>
            <span class="cov-badge">REQ Coverage: <strong>${cov.requirement_coverage_pct ?? 100}%</strong></span>
            <span class="cov-badge">CI Coverage: <strong>${cov.coverage_item_pct ?? 100}%</strong></span>
            <span class="cov-badge success">Written to Disk (.generated.spec.ts)</span>
          `;
        }
        if (preview && data.spec_code) {
          preview.textContent = data.spec_code;
        }

        if (data.job_id) {
          activeJobId = data.job_id;
          await pollJobs();
        }

        window.dispatchEvent(new CustomEvent('work-items-updated'));
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : String(err);
        if (resultBox) {
          resultBox.style.display = 'flex';
          resultBox.innerHTML = `<span class="status-msg error">Lỗi đọc link: ${escHtml(msg)}</span>`;
        }
      } finally {
        if (btnSmartResolve) {
          btnSmartResolve.disabled = false;
          btnSmartResolve.innerHTML = '<span>🚀 Đọc Link &amp; Tự Tạo File Test</span>';
        }
      }
    });

    // Presets click handlers (initial buttons in HTML)
    document.querySelectorAll<HTMLButtonElement>('.btn-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        const title = btn.dataset.title || 'Command';
        const cmd = btn.dataset.cmd || '';
        const cwd = btn.dataset.cwd || '';
        runAutomationJob(title, cmd, cwd);
      });
    });

    // Custom Command Runner
    document.getElementById('btn-run-custom')?.addEventListener('click', () => {
      const cmdInput = document.getElementById('custom-cmd-input') as HTMLInputElement | null;
      const cwdInput = document.getElementById('custom-cwd-input') as HTMLInputElement | null;
      const cmd = cmdInput?.value.trim() || '';
      const cwd = cwdInput?.value.trim() || '';
      if (!cmd) {
        alert('Vui lòng nhập lệnh CLI cần chạy!');
        cmdInput?.focus();
        return;
      }
      runAutomationJob(`Custom: ${cmd.slice(0, 28)}`, cmd, cwd);
    });

    // 5-Stage ISTQB Generate Button
    const btnGen = document.getElementById('btn-qc-generate') as HTMLButtonElement | null;
    btnGen?.addEventListener('click', async () => {
      const srcInput = document.getElementById('qc-source') as HTMLInputElement | null;
      const specInput = document.getElementById('qc-spec') as HTMLInputElement | null;
      const taskIdInput = document.getElementById('qc-task-id') as HTMLInputElement | null;
      const outPathInput = document.getElementById('qc-out-spec') as HTMLInputElement | null;
      const writeAlongside = document.getElementById('qc-write-alongside') as HTMLInputElement | null;
      const syncHarness = document.getElementById('qc-sync-harness') as HTMLInputElement | null;
      const runAfter = document.getElementById('qc-run-after') as HTMLInputElement | null;
      const statusMsg = document.getElementById('qc-gen-status');

      const source = srcInput?.value.trim() || '';
      if (!source) {
        alert('Vui lòng chọn hoặc nhập đường dẫn file nguồn cần test (Source file)!');
        srcInput?.focus();
        return;
      }

      if (btnGen) {
        btnGen.disabled = true;
        btnGen.textContent = 'Đang chạy 5-Stage...';
      }

      try {
        const payload = {
          source: source,
          spec: specInput?.value.trim() || '',
          task_id: taskIdInput?.value ? Number(taskIdInput.value) : null,
          out_spec: outPathInput?.value.trim() || '/tmp/generated.spec.ts',
          write_alongside: Boolean(writeAlongside?.checked),
          sync_harness: Boolean(syncHarness?.checked),
          run_test: Boolean(runAfter?.checked),
          target_node: getActivePaseoNode(),
        };

        const res = await fetch('/api/automation/qc-generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || `HTTP ${res.status}`);
        }

        const data: QcGenerateResponse = await res.json();
        const cov = data.coverage_report || {};

        // Display results
        const resBox = document.getElementById('qc-result-box');
        const badges = document.getElementById('qc-cov-badges');
        const preview = document.getElementById('qc-spec-preview');

        if (resBox) resBox.style.display = 'flex';
        if (badges) {
          badges.innerHTML = `
            <span class="cov-badge">Total Cases: <strong>${cov.total_cases ?? 0}</strong></span>
            <span class="cov-badge">REQ Coverage: <strong>${cov.requirement_coverage_pct ?? 0}%</strong></span>
            <span class="cov-badge">CI Coverage: <strong>${cov.coverage_item_pct ?? 0}%</strong></span>
            <span class="cov-badge">Symbol Coverage: <strong>${cov.symbol_coverage_pct ?? 0}%</strong></span>
            <span class="cov-badge success">Out: ${escHtml(data.out_spec || '/tmp/generated.spec.ts')}</span>
          `;
        }
        if (preview) {
          preview.textContent = data.spec_code || JSON.stringify(cov, null, 2);
        }

        if (statusMsg) {
          statusMsg.textContent = `Đã sinh ${cov.total_cases ?? 0} testcases → ${data.out_spec || '/tmp/generated.spec.ts'}`;
          statusMsg.className = 'status-msg success';
        }

        if (data.job_id) {
          activeJobId = data.job_id;
          await pollJobs();
        }

        // Trigger work items refresh if testcases synced to DB
        if (payload.sync_harness) {
          window.dispatchEvent(new CustomEvent('work-items-updated'));
        }
      } catch (err: unknown) {
        const message = err instanceof Error ? err.message : String(err);
        if (statusMsg) {
          statusMsg.textContent = 'Lỗi: ' + message;
          statusMsg.className = 'status-msg error';
        }
        alert('Lỗi sinh Unit Test: ' + message);
      } finally {
        if (btnGen) {
          btnGen.disabled = false;
          btnGen.innerHTML = `
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <span>Sinh Unit Test (5-Stage)</span>`;
        }
      }
    });

    // Dispatch QC Agent Button
    document.getElementById('btn-qc-dispatch-agent')?.addEventListener('click', async () => {
      const srcInput = document.getElementById('qc-source') as HTMLInputElement | null;
      const specInput = document.getElementById('qc-spec') as HTMLInputElement | null;
      const tidInput = document.getElementById('qc-task-id') as HTMLInputElement | null;

      const src = srcInput?.value.trim() || 'projects/wicx-crm-fe/libs/wicx-core/src/utils/helps/validator.helper.ts';
      const spc = specInput?.value.trim() || 'projects/wicx-crm-fe/libs/wicx-core/spec.md';
      const tid = tidInput?.value ? tidInput.value : '';

      const prompt = `Chạy tools/qc_test_generator.py cho source '${src}' và spec '${spc}'${tid ? ' (Work Item #' + tid + ')' : ''}, hoàn thiện assertions cho unit test và kiểm tra regression suite.`;

      try {
        const res = await fetch('/api/agents/call', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ profile: 'QC', item_id: tid ? Number(tid) : null, prompt }),
        });
        const out = await res.json();
        if (out.job_id) {
          activeJobId = out.job_id;
          await pollJobs();
        }
        alert('Đã giao nhiệm vụ kiểm thử cho Agent QC! Đang theo dõi log...');
      } catch (e: unknown) {
        const msg = e instanceof Error ? e.message : String(e);
        alert('Lỗi giao Agent QC: ' + msg);
      }
    });

    // Copy Generated Spec Button
    document.getElementById('btn-copy-spec')?.addEventListener('click', () => {
      const preview = document.getElementById('qc-spec-preview');
      if (preview && preview.textContent) {
        navigator.clipboard.writeText(preview.textContent).then(() => {
          const btn = document.getElementById('btn-copy-spec');
          if (btn) {
            btn.textContent = 'Đã sao chép!';
            setTimeout(() => {
              btn.textContent = 'Sao chép code';
            }, 1500);
          }
        });
      }
    });

    // Refresh Jobs Button
    document.getElementById('btn-refresh-jobs')?.addEventListener('click', pollJobs);

    // Prefill Task ID from WorkItemsBoard
    window.addEventListener('prefill-qc-task', ((e: CustomEvent<{ taskId: string }>) => {
      const tidInput = document.getElementById('qc-task-id') as HTMLInputElement | null;
      if (tidInput && e.detail.taskId) {
        tidInput.value = e.detail.taskId;
      }
      const smartInput = document.getElementById('smart-dev-link') as HTMLInputElement | null;
      if (smartInput && e.detail.taskId) {
        smartInput.value = `#${e.detail.taskId}`;
      }
    }) as EventListener);
  }

  function initQcWorkbench() {
    setupQcEvents();
    loadPaseoNodes();
    loadSourceFilesAndPresets();
    pollJobs();

    // Auto poll jobs every 2500ms
    qcJobPollInterval = window.setInterval(pollJobs, 2500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initQcWorkbench);
  } else {
    initQcWorkbench();
  }

  window.addEventListener('beforeunload', () => {
    if (qcJobPollInterval !== null) {
      clearInterval(qcJobPollInterval);
    }
  });
</script>

