# Room Agent Environment Configuration Example
# Copy to .env and adjust variables as needed

HARNESS_MODEL=ag/gemini-3.8-flash-high
HARNESS_BACKEND=floci
FLOCI_ENDPOINT=http://127.0.0.1:14566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=floci_local_key
AWS_SECRET_ACCESS_KEY=floci_local_secret
FLOCI_S3_BUCKET=harness-data
HARNESS_LOG_LEVEL=info

# Optional Remote AI / LLM Gateway endpoints
AI_GATEWAY_URL=http://127.0.0.1:8008/v1
KEV_ENDPOINT=http://127.0.0.1:8008/v1/systemone

# Workspace & Worktree base paths (Leave empty for automatic detection)
# WORKTREE_BASE_DIR=
