HARNESS_MODEL=gemini-3.7-medium
HARNESS_BACKEND=floci
FLOCI_ENDPOINT=http://<FLOCI_HOST>:14566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
FLOCI_S3_BUCKET=harness-data
AZURE_DEVOPS_ORG_URL=https://remote.example.com/MainCollection
AZURE_DEVOPS_DEFAULT_PROJECT=ACME
AZURE_DEVOPS_PAT=your_remote_personal_access_token
HARNESS_LOG_LEVEL=info
